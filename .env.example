# ──────────────────────────────────────────────────────────────────────────────
# GeoSight — environment template
# Copy to .env.local (web) / .env (api, workers) and fill in values.
# ──────────────────────────────────────────────────────────────────────────────

# ── Core ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000

# ── Database (Neon Postgres) ─────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host/geosight?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@host/geosight?sslmode=require

# ── Redis / Queues (Upstash) ─────────────────────────────────────────────────
REDIS_URL=redis://default:password@host:6379
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Clerk (auth) ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=

# ── Stripe (billing) ─────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ── BYOK encryption (AES-256-GCM master key — 32-byte hex) ───────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BYOK_MASTER_KEY=

# ── AI providers (used only for internal dogfooding / Phase 0 spike) ─────────
# Customers bring their own keys via the BYOK vault.
OPENAI_API_KEY=
GOOGLE_AI_API_KEY=
PERPLEXITY_API_KEY=

# ── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM="GeoSight <noreply@geosight.app>"

# ── Storage (Cloudflare R2 — S3-compatible) ──────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=geosight-reports
R2_PUBLIC_URL=

# ── Observability ────────────────────────────────────────────────────────────
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=info
