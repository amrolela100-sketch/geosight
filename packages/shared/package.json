{
  "name": "@geosight/shared",
  "version": "0.0.0",
  "private": true,
  "description": "GeoSight cross-cutting types, Zod schemas, constants, and pure utilities shared across web/api/workers.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schemas": "./src/schemas/index.ts",
    "./constants": "./src/constants/index.ts",
    "./types": "./src/types/index.ts"
  },
  "scripts": {
    "dev": "tsc --watch --preserveWatchOutput",
    "build": "tsc",
    "lint": "eslint src --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "echo \"@geosight/shared: tests pending\" && exit 0",
    "clean": "rimraf dist .turbo"
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@geosight/config": "workspace:*",
    "eslint": "^9.10.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.5.4"
  }
}
