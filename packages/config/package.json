{
  "name": "@geosight/config",
  "version": "0.0.0",
  "private": true,
  "description": "Shared TypeScript, ESLint, and Tailwind base configs for the GeoSight monorepo.",
  "type": "module",
  "files": ["typescript", "eslint", "tailwind"],
  "exports": {
    "./eslint/base": "./eslint/base.js",
    "./eslint/next": "./eslint/next.js",
    "./eslint/node": "./eslint/node.js",
    "./tailwind/base": "./tailwind/base.cjs"
  },
  "scripts": {
    "lint": "echo \"@geosight/config: no lint target\" && exit 0",
    "typecheck": "echo \"@geosight/config: no typecheck target\" && exit 0",
    "clean": "echo \"@geosight/config: nothing to clean\" && exit 0"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.4.0",
    "@typescript-eslint/parser": "^8.4.0",
    "eslint": "^9.10.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.30.0",
    "eslint-plugin-unused-imports": "^4.1.4",
    "typescript": "^5.5.4"
  }
}
